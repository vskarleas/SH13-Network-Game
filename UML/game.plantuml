@startuml
participant "Client 1" as C1
participant "Client 2" as C2
participant "Client 3" as C3
participant "Client 4" as C4
participant "All" as All
participant "Server" as S

note over S: Server maintains the shared matrix state

C1 -> S:  Send "G gID objetSel"
alt Guess Valid
    S -> S: Update matrix
    S -> C1: Correct guess
    S -> C2: Broadcast correct guess
    S -> C3: Broadcast correct guess
    S -> C4: Broadcast correct guess
else Guess Invalid
    S -> C1: Invalid guess
end

C1 -> S: Send "O obj"
S -> All: broadcast(if matrix[obj] is NULL then 0 else V)

C1 -> S: Send "S gID objetSel"
S -> All: broadcast(matrix[gID][objetSel])

C2 -> S: Send guess
alt Guess Valid
    S -> S: Update matrix
    S -> C2: Correct guess
    S -> C1: Broadcast correct guess
    S -> C3: Broadcast correct guess
    S -> C4: Broadcast correct guess
else Guess Invalid
    S -> C2: Invalid guess
end

C2 -> S: Send "O obj"
S -> All: broadcast(if matrix[obj] is NULL then 0 else V)

C2 -> S: Send "S gID objetSel"
S -> All: broadcast(matrix[gID][objetSel])

C3 -> S: Send guess
alt Guess Valid
    S -> S: Update matrix
    S -> C3: Correct guess
    S -> C1: Broadcast correct guess
    S -> C2: Broadcast correct guess
    S -> C4: Broadcast correct guess
else Guess Invalid
    S -> C3: Invalid guess
end

C3 -> S: Send "O obj"
S -> All: broadcast(if matrix[obj] is NULL then 0 else V)

C3 -> S: Send "S gID objetSel"
S -> All: broadcast(matrix[gID][objetSel])

C4 -> S: Send guess
alt Guess Valid
    S -> S: Update matrix
    S -> C4: Correct guess
    S -> C1: Broadcast correct guess
    S -> C2: Broadcast correct guess
    S -> C3: Broadcast correct guess
else Guess Invalid
    S -> C4: Invalid guess
end

C4 -> S: Send "O obj"
S -> All: broadcast(if matrix[obj] is NULL then 0 else V)

C4 -> S: Send "S gID objetSel"
S -> All: broadcast(matrix[gID][objetSel])

@enduml
